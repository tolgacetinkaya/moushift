<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF hosts the UI and its manifest owns DPI; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Moushift.ico</ApplicationIcon>
    <AssemblyName>Moushift</AssemblyName>
    <RootNamespace>Clickloom.App</RootNamespace>
    <Version>0.14.9</Version>
    <Description>Customize your mouse with per-device profiles and a radial shortcut menu.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/*.png" />
    <ProjectReference Include="../Clickloom.Core/Clickloom.Core.csproj" />
    <ProjectReference Include="../Clickloom.Windows/Clickloom.Windows.csproj" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Clickloom.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Clickloom.App.MainWindow" Title="Moushift" Width="1440" Height="1024" MinWidth="1100" MinHeight="760" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Loaded="Layout_Loaded" SizeChanged="Layout_SizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Visibility x:Key="SidebarLabelVisibility">Visible</Visibility>
    <Thickness x:Key="SidebarIconMargin">0,0,12,0</Thickness>
    <DataTemplate x:Key="BatteryBadge">
      <StackPanel Orientation="Horizontal" ToolTip="{Binding BatteryDescription}" Visibility="{Binding BatteryVisibility}">
        <Grid Width="30" Height="14" Margin="0,0,9,0">
          <Border Width="26" Height="12" HorizontalAlignment="Left" BorderBrush="{DynamicResource Muted}" BorderThickness="1" CornerRadius="2"/>
          <Border Width="2" Height="5" HorizontalAlignment="Right" Background="{DynamicResource Muted}" CornerRadius="1"/>
          <Border Width="{Binding BatteryFillWidth}" Height="8" HorizontalAlignment="Left" Margin="2,0,0,0" Background="{DynamicResource Accent}" CornerRadius="1"/>
        </Grid>
        <TextBlock Text="{Binding BatteryLabel}" FontSize="13" Foreground="{DynamicResource Ink}"/>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="DeviceTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="{DynamicResource DeviceTileWidth}"/><Setter Property="Height" Value="{DynamicResource DeviceTileHeight}"/>
      <Setter Property="Padding" Value="24,16"/><Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{DynamicResource DashboardCard}"/><Setter Property="BorderBrush" Value="{DynamicResource DashboardEdge}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <local:FacetedBorder x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24" Padding="{TemplateBinding Padding}"><ContentPresenter/></local:FacetedBorder>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource DashboardHover}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Tile" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="DeviceTileTemplate">
      <Button x:Name="DeviceTileButton" Click="DeviceCard_Click" Tag="{Binding}" IsEnabled="{Binding CanEdit}" Style="{StaticResource DeviceTile}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Detail}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
          <TextBlock x:Name="DeviceTileName" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="21" LineStackingStrategy="BlockLineHeight" MaxHeight="44" ToolTip="{Binding Name}"/>
          <local:FacetedBorder Grid.Row="1" Background="{DynamicResource DashboardPill}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="{Binding Detail}">
            <StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,6,0"/><TextBlock Text="{Binding ConnectionLabel}" Foreground="{DynamicResource Ink}" FontSize="12"/></StackPanel>
          </local:FacetedBorder>
          <Border Grid.Row="2" CornerRadius="16" Padding="8,0">
            <Border.Background><RadialGradientBrush Center="0.50,0.55" GradientOrigin="0.50,0.55" RadiusX="0.57" RadiusY="0.53"><GradientStop Color="{Binding Color, Source={StaticResource DashboardGlow}}" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Border.Background>
            <local:MouseIllustration x:Name="DeviceTileArtwork" Accent="{DynamicResource Accent}"/>
          </Border>
          <Grid Grid.Row="3" Margin="0,7,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Activity}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Activity}"/>
              <ContentControl Content="{Binding}" Visibility="{Binding BatteryVisibility}" ContentTemplate="{StaticResource BatteryBadge}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource DashboardPill}" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </Grid>
      </Button>
    </DataTemplate>
    <Style x:Key="ContextAction" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="40"/></Style>
    <Style x:Key="Marker" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{DynamicResource Panel}" CornerRadius="13">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="13">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
  </Window.Resources>
  <Border x:Name="ThemeFrame" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource MetalEdge}" BorderThickness="1" CornerRadius="10" TextElement.Foreground="{DynamicResource Ink}" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.FontSize="14">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
      <Border Grid.RowSpan="3" CornerRadius="12" IsHitTestVisible="False">
        <Border.Background><ImageBrush ImageSource="{DynamicResource WorkspaceArtwork}" Stretch="UniformToFill" AlignmentY="Bottom"/></Border.Background>
      </Border>
      <Border Grid.RowSpan="3" CornerRadius="12" IsHitTestVisible="False" Background="{DynamicResource WorkspaceScrim}"/>
      <local:FacetedBorder x:Name="ThemeTitleBar" Margin="16,10,16,0" Background="{DynamicResource WorkspaceChrome}" BorderBrush="{DynamicResource DashboardEdge}" BorderThickness="1" CornerRadius="25">
        <Grid Margin="11,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Margin="6,0,18,0" VerticalAlignment="Center">
            <local:BrandMark Width="31" Height="31" Foreground="{DynamicResource Accent}"/>
            <TextBlock Text="Moushift" FontSize="21" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" KeyboardNavigation.TabNavigation="Continue">
            <Button x:Name="DevicesNav" ToolTip="Devices" AutomationProperties.Name="Devices" Style="{StaticResource Navigation}" Click="DevicesNav_Click">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE962;" Margin="{DynamicResource SidebarIconMargin}"/><TextBlock Visibility="{DynamicResource SidebarLabelVisibility}" Text="Devices"/></StackPanel>
            </Button>
            <Button x:Name="ProfilesNav" ToolTip="Profiles" AutomationProperties.Name="Profiles" Style="{StaticResource Navigation}" Click="ProfilesNav_Click">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8F1;" Margin="{DynamicResource SidebarIconMargin}"/><TextBlock Visibility="{DynamicResource SidebarLabelVisibility}" Text="Profiles"/></StackPanel>
            </Button>
            <Button x:Name="AppearanceNav" ToolTip="Settings" AutomationProperties.Name="Settings" Style="{StaticResource Navigation}" Click="AppearanceNav_Click">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Margin="{DynamicResource SidebarIconMargin}"/><TextBlock Visibility="{DynamicResource SidebarLabelVisibility}" Text="Settings"/></StackPanel>
            </Button>
            <Button x:Name="AboutNav" ToolTip="Help" AutomationProperties.Name="Help" Style="{StaticResource Navigation}" Click="AboutNav_Click">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE897;" Margin="{DynamicResource SidebarIconMargin}"/><TextBlock Visibility="{DynamicResource SidebarLabelVisibility}" Text="Help"/></StackPanel>
            </Button>
            <Button x:Name="SidebarToggle" Click="ToggleSidebar_Click" Style="{StaticResource Navigation}" Width="32" Padding="0" HorizontalContentAlignment="Center" ToolTip="Use compact navigation" AutomationProperties.Name="Toggle compact navigation"><TextBlock x:Name="SidebarToggleIcon" FontFamily="Segoe Fluent Icons" Text="&#xE76B;"/></Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock x:Name="EngineBadge" Text="Paused" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,12,0"/>
            <Button x:Name="EnableButton" Content="Enable Circle" Click="Enable_Click" MinWidth="100" Margin="0,0,8,0" Style="{StaticResource Primary}"/>
            <Button Click="ToggleTheme_Click" Style="{StaticResource Navigation}" Width="34" Padding="0" HorizontalContentAlignment="Center" ToolTip="Switch light or dark appearance" AutomationProperties.Name="Toggle light and dark theme"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE793;" FontSize="16"/></Button>
            <Button Content="&#xE921;" FontFamily="Segoe Fluent Icons" Style="{StaticResource CaptionButton}" Click="Minimize_Click" AutomationProperties.Name="Minimize"/>
            <Button Content="&#xE922;" FontFamily="Segoe Fluent Icons" Style="{StaticResource CaptionButton}" Click="Maximize_Click" AutomationProperties.Name="Maximize or restore"/>
            <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Style="{StaticResource CaptionButton}" Click="CloseWindow_Click" AutomationProperties.Name="Close window"/>
          </StackPanel>
        </Grid>
      </local:FacetedBorder>
      <Grid Grid.Row="1" Margin="0,7,0,0">
        <TextBlock x:Name="PageTitle" Visibility="Collapsed"/>
        <Grid>
          <Grid x:Name="DevicesWorkspace">
            <Grid.ColumnDefinitions><ColumnDefinition MinWidth="380" Width="*"/><ColumnDefinition x:Name="InspectorSplitterColumn" Width="0"/><ColumnDefinition x:Name="InspectorColumn" MinWidth="0" MaxWidth="640" Width="0"/></Grid.ColumnDefinitions>
            <Grid x:Name="DevicesPage" Margin="24,22,24,16">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="2,0,2,18">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Your mice" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="Manage buttons and Click Circle for each mouse." Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                <Button Grid.Column="1" Click="RefreshDevices_Click" Padding="12,6" VerticalAlignment="Center" Background="{DynamicResource DashboardCard}" BorderBrush="{DynamicResource DashboardEdge}" ToolTip="Refresh connections" AutomationProperties.Name="Refresh devices"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/><TextBlock Text="Refresh"/></StackPanel></Button>
              </Grid>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="186"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <local:FacetedBorder Background="{DynamicResource DashboardCard}" BorderBrush="{DynamicResource DashboardEdge}" BorderThickness="1" CornerRadius="22" Padding="22,16" Margin="0,0,0,12">
                      <StackPanel>
                        <TextBlock Text="Windows connections" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DashboardConnectionCount" Text="0" FontSize="48" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,1,0,0"/>
                        <TextBlock x:Name="DashboardReceiverCount" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                      </StackPanel>
                    </local:FacetedBorder>
                    <local:FacetedBorder x:Name="DashboardBattery" Background="{DynamicResource DashboardRaised}" BorderBrush="{DynamicResource DashboardEdge}" BorderThickness="1" CornerRadius="22" Padding="22,14" Margin="0,0,0,12" Visibility="Collapsed" ToolTip="Lowest available battery level reported by Windows">
                      <StackPanel>
                        <TextBlock Text="Lowest reported battery" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                        <Grid Height="91" Width="91" Margin="0,10,0,9">
                          <local:DashboardBatteryDial Percent="{Binding BatteryPercent}" Accent="{DynamicResource Accent}" Track="{DynamicResource Line}"/>
                          <TextBlock Text="{Binding BatteryLabel}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                      </StackPanel>
                    </local:FacetedBorder>
                    <local:FacetedBorder Background="{DynamicResource DashboardCard}" BorderBrush="{DynamicResource DashboardEdge}" BorderThickness="1" CornerRadius="22" Padding="18,7">
                      <Expander Header="Connection details">
                        <StackPanel Margin="4,8,4,8">
                          <TextBlock x:Name="DevicesSubtitle" Style="{StaticResource Caption}" FontSize="11"/>
                          <TextBlock Text="A receiver can stay connected while its mouse is off." Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,6"/>
                          <ItemsControl x:Name="ReceiverConnectionsList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                          <Expander x:Name="AdditionalDevicesExpander" Header="Other interfaces" Margin="0,6,0,0"><ItemsControl x:Name="AdditionalDevicesList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="4,4,0,4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="10" Margin="0,3,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                          <TextBlock x:Name="PresenceDetails" Style="{StaticResource Caption}" FontSize="10" Margin="0,8,0,0"/>
                          <ItemsControl x:Name="DriverProfilesList" Visibility="Collapsed"/>
                        </StackPanel>
                      </Expander>
                    </local:FacetedBorder>
                  </StackPanel>
                </ScrollViewer>
                <local:FacetedBorder Grid.Column="2" Background="{DynamicResource DashboardStage}" BorderBrush="{DynamicResource DashboardEdge}" BorderThickness="1" CornerRadius="28" Padding="16">
                  <Grid>
                    <ScrollViewer x:Name="DeviceGalleryScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" Padding="8,8,0,8">
                      <ItemsControl x:Name="DeviceCardsList" ItemTemplate="{StaticResource DeviceTileTemplate}" KeyboardNavigation.TabNavigation="Continue" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </ScrollViewer>
                    <local:FacetedBorder x:Name="EmptyDevicesBox" Background="{DynamicResource DashboardCard}" BorderBrush="{DynamicResource DashboardEdge}" BorderThickness="1" CornerRadius="22" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <StackPanel><TextBlock x:Name="EmptyDevicesText" Text="No mouse connections" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Connect a mouse or receiver to get started." Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel>
                    </local:FacetedBorder>
                  </Grid>
                </local:FacetedBorder>
              </Grid>
            </Grid>
            <Grid x:Name="DeviceDetailPage" Visibility="Collapsed" Margin="20,13,14,14">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Margin="4,0,4,17">
                <Button x:Name="DetailBackButton" Content="‹  All mice" Click="BackToGallery_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <TextBlock x:Name="DetailHeading" FontSize="35" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ContentControl x:Name="DetailBatteryInfo" Visibility="{Binding Content.BatteryVisibility, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource BatteryBadge}" HorizontalAlignment="Left" Margin="0,9,0,0"/>
              </StackPanel>
              <local:FacetedBorder Grid.Row="1" Background="{DynamicResource DashboardStage}" BorderBrush="{DynamicResource DashboardEdge}" BorderThickness="1" CornerRadius="28" Padding="24,14">
                <Grid x:Name="DiagramPane">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="1" x:Name="DiagramStage" MaxWidth="440" MaxHeight="550">
                    <Border CornerRadius="26" IsHitTestVisible="False">
                      <Border.Background><RadialGradientBrush Center="0.5,0.55" GradientOrigin="0.5,0.55" RadiusX="0.55" RadiusY="0.5"><GradientStop Color="{Binding Color, Source={StaticResource DashboardGlow}}" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Border.Background>
                    </Border>
                    <local:MouseIllustration x:Name="HeroMouse" Accent="{DynamicResource Accent}" />
                    <local:MouseConnections x:Name="DiagramLinks" Visibility="Collapsed" IsHitTestVisible="False" />
                    <Canvas x:Name="MarkerCanvas">
                      <Button x:Name="LeftCallout" Style="{StaticResource Marker}" Content="1" Tag="LeftButton" Click="MouseCallout_Click" AutomationProperties.Name="Left button" />
                      <Button x:Name="RightCallout" Style="{StaticResource Marker}" Content="2" Tag="RightButton" Click="MouseCallout_Click" AutomationProperties.Name="Right button" />
                      <Button x:Name="MiddleCallout" Style="{StaticResource Marker}" Content="3" Tag="MiddleButton" Click="MouseCallout_Click" AutomationProperties.Name="Wheel button" />
                      <Button x:Name="ForwardCallout" Grid.Row="1" Style="{StaticResource Marker}" Content="4" Tag="XButton2" Click="MouseCallout_Click" AutomationProperties.Name="Forward button, front side button" />
                      <Button x:Name="BackCallout" Grid.Row="2" Style="{StaticResource Marker}" Content="5" Tag="XButton1" Click="MouseCallout_Click" AutomationProperties.Name="Back button, rear side button" />
                    </Canvas>
                    <StackPanel Visibility="Collapsed">
                      <TextBlock x:Name="LeftCalloutAction" />
                      <TextBlock x:Name="RightCalloutAction" />
                      <TextBlock x:Name="MiddleCalloutAction" />
                      <TextBlock x:Name="ForwardCalloutAction" />
                      <TextBlock x:Name="BackCalloutAction" />
                    </StackPanel>
                  </Grid>
                  <DockPanel LastChildFill="True" Margin="3,0,3,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                      <RadioButton x:Name="TopViewButton" Content="Top view" Style="{StaticResource ViewChoice}" GroupName="MouseView" IsChecked="True" Checked="MouseView_Changed" Margin="0,0,6,0"/>
                      <RadioButton x:Name="LeftViewButton" Content="Left side" Style="{StaticResource ViewChoice}" GroupName="MouseView" Checked="MouseView_Changed"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="Button map" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Select a marker to edit its assignment." Style="{StaticResource Caption}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                  </DockPanel>
                  <StackPanel Grid.Row="2">
                  <Button x:Name="InputTestButton" Content="Test a button" Click="InputTest_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                  <TextBlock x:Name="InputTestResult" Visibility="Collapsed" TextWrapping="Wrap" MaxHeight="92" TextTrimming="CharacterEllipsis"
                             Style="{StaticResource Caption}" Margin="0,8,0,0"
                             AutomationProperties.LiveSetting="Polite"/>
                  <Expander x:Name="ScopeExpander" Header="Input support" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock x:Name="ScopeLabel" Style="{StaticResource Caption}" />
                      <TextBlock x:Name="ScopeDescription" Style="{StaticResource Caption}" FontSize="12" />
                      <CheckBox x:Name="DeviceScopeCheck" Visibility="Collapsed" Content="Only this device" Checked="DeviceScope_Changed" Unchecked="DeviceScope_Changed" Margin="0,8,0,0" />
                      <TextBlock x:Name="DeviceScopeHint" Style="{StaticResource Caption}" FontSize="11" />
                      <CheckBox x:Name="ShowAuxiliaryCheck" Visibility="Collapsed" Content="Extra buttons (F13–F24)" Checked="ShowAuxiliary_Changed" Unchecked="ShowAuxiliary_Changed" Margin="0,10,0,0" />
                    </StackPanel>
                  </Expander>
                  </StackPanel>
                </Grid>
              </local:FacetedBorder>
            </Grid>
            <GridSplitter x:Name="InspectorSplitter" Visibility="Collapsed" Grid.Column="1" Style="{StaticResource WorkspaceSplitter}" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="InspectorSplitter_DragCompleted" ToolTip="Drag to resize settings" AutomationProperties.Name="Resize settings panel"/>
            <local:FacetedBorder x:Name="DeviceInspector" Grid.Column="2" Visibility="Collapsed" Margin="0,13,18,14" Background="{DynamicResource DashboardCard}" BorderBrush="{DynamicResource DashboardEdge}" BorderThickness="1" CornerRadius="28">
              <Grid>
                <StackPanel x:Name="InspectorEmpty" VerticalAlignment="Center" Margin="28"><TextBlock Text="Your mouse, your setup." FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Choose a mouse on the left to edit its buttons and Click Circle." Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel>
                <Border x:Name="MappingPage" Visibility="Collapsed" Padding="24,19,24,12">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                      <TextBlock Text="Assignments" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>

                      <Grid x:Name="ProfileToolbar"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,14,0,0"><TextBlock Text="Application profile" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged" DisplayMemberPath="Name" AutomationProperties.Name="Application profile"/></StackPanel>
                        <Button Grid.Column="1" Content="+ Add app" Click="AddProfile_Click" Margin="8,0,0,0" VerticalAlignment="Bottom" ToolTip="Add settings for an application on this mouse" AutomationProperties.Name="Add application profile"/>
                      </Grid>
                      <TextBlock x:Name="ProfileContext" Style="{StaticResource Caption}" FontSize="11" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Margin="0,18,0,8">
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button x:Name="MappingsNav" Content="Buttons" Style="{StaticResource ContextAction}" Click="MappingsNav_Click"/><Button x:Name="RingNav" Content="Customize Circle" Style="{StaticResource ContextAction}" Click="CircleTab_Click" Margin="6,0,0,0"/></StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                      <StackPanel>
                        <StackPanel x:Name="ButtonsContent">
                  <Expander x:Name="SourceExpander" IsExpanded="True" Template="{StaticResource PlainExpander}">
                    <ListBox x:Name="BindingsList" SelectionChanged="BindingsList_SelectionChanged" KeyDown="BindingsList_KeyDown" AutomationProperties.Name="Mouse buttons" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="0,0,0,5" />
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Button x:Name="EditBindingButton" Tag="{Binding}" Click="EditBinding_Click" HorizontalContentAlignment="Stretch" Padding="12,9"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Edit {0}'}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="28" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource Muted}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" ToolTip="{Binding Summary}"/>
                            <TextBlock Grid.Column="3" Text="Edit" Foreground="{DynamicResource Accent}" FontSize="12" HorizontalAlignment="Right" />
                          </Grid>
                          </Button>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Expander>
                  <Border x:Name="EditorPane" Visibility="Collapsed" Background="Transparent" Padding="0,10,0,0" MinHeight="310">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock x:Name="SelectedInputTitle" Text="Back button" FontSize="16" FontWeight="SemiBold" />
                          <TextBlock x:Name="SelectedInputHint" Text="Rear side button" Visibility="Collapsed"/>
                        </StackPanel>
                        <Button x:Name="CloseBindingButton" Grid.Column="1" Content="‹  All buttons" Click="CloseEditor_Click" FontSize="12" Padding="12,7" Margin="10,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Back to all mouse buttons"/>
                      </Grid>
                      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                          <TextBlock Text="Action" Style="{StaticResource FieldLabel}" />
                          <ComboBox x:Name="ActionCombo" SelectionChanged="ActionCombo_SelectionChanged" DisplayMemberPath="Name" SelectedValuePath="Kind" AutomationProperties.Name="Assigned action" />
                          <Border x:Name="ActionDescriptionBox" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ActionDescription" Style="{StaticResource Caption}" />
                          </Border>
                          <StackPanel x:Name="ShortcutPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="Shortcut" Style="{StaticResource FieldLabel}" FontSize="12" />
                            <local:ShortcutSelector x:Name="ShortcutChoice" Changed="ShortcutChoice_Changed" />
                            <Expander Header="Quick shortcuts" Margin="0,10,0,0">
                              <WrapPanel>
                                <Button Content="Alt + Tab" Tag="alt-tab" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Copy" Tag="copy" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Paste" Tag="paste" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Undo" Tag="undo" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Close tab" Tag="close" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Play / pause" Tag="media" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Mute" Tag="mute" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                              </WrapPanel>
                            </Expander>
                          </StackPanel>
                          <StackPanel x:Name="MouseOutputPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="Output mouse button" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="MouseOutputCombo" DisplayMemberPath="Name" SelectedValuePath="Control" SelectionChanged="EditorField_Changed" AutomationProperties.Name="Output mouse button" />
                          </StackPanel>
                          <StackPanel x:Name="TextPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="Text to type" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TextActionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" MaxLength="10000" TextChanged="EditorField_Changed" AutomationProperties.Name="Text to type" />
                          </StackPanel>
                          <StackPanel x:Name="LaunchPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="Application to open" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseAction_Click" Margin="8,0,0,0" />
                              <TextBox x:Name="ApplicationPathBox" TextChanged="EditorField_Changed" AutomationProperties.Name="Application file" />
                            </DockPanel>
                            <TextBlock Text="Launch arguments (optional)" Style="{StaticResource Caption}" Margin="0,16,0,8" />
                            <TextBox x:Name="ArgumentsBox" TextChanged="EditorField_Changed" AutomationProperties.Name="Launch arguments" />
                          </StackPanel>
                          <StackPanel x:Name="RingPanel" Visibility="Collapsed" Margin="0,12,0,0">

                            <Button Content="Edit circle" Click="EditRing_Click" Margin="0,16,0,8" />
                            <Button Content="Open preview" Click="PreviewRing_Click" />
                          </StackPanel>
                          <TextBlock x:Name="AuxiliaryHint" Text="For an extra button configured as F13–F24 in your vendor app." Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,20,0,0" />
                          <Expander Header="Last input result" Margin="0,22,0,12">
                            <TextBlock x:Name="LastInputResultText" Text="No button detected yet." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                          </Expander>
                        </StackPanel>
                      </ScrollViewer>
                      <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                        <StackPanel>
                          <TextBlock x:Name="SavedActionText" Text="Saved: Default" Style="{StaticResource Caption}" Visibility="Collapsed" />
                          <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <Button Content="Restore default" Click="ResetBinding_Click" Style="{StaticResource Quiet}" Padding="0,2" FontSize="12" MinHeight="24" />
                              <TextBlock x:Name="DraftStatusText" Text="No changes" Foreground="{DynamicResource Muted}" FontSize="11" />
                            </StackPanel>
                            <Button x:Name="ApplyBindingButton" Grid.Column="1" Content="Apply" Click="SaveBinding_Click" Style="{StaticResource Primary}" MinWidth="92" VerticalAlignment="Center" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                        </StackPanel>
                        <Expander Header="Profile options" Margin="0,8,0,0"><StackPanel Margin="0,10,0,8">
                          <CheckBox x:Name="AutoSwitchCheck" Content="Switch with active app" Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed" FontSize="12" Margin="0,0,0,15"/>
                          <Button x:Name="ImportPreviousButton" Content="Import previous assignments…" Click="ImportPrevious_Click" Style="{StaticResource Quiet}" FontSize="12"/>
                          <Button Content="Reset buttons…" Click="ResetProfileButtons_Click" Style="{StaticResource Quiet}" FontSize="12"/>
                        </StackPanel></Expander>
                        <Expander Header="Circle layouts" Margin="0,8,0,0">
                          <StackPanel Margin="0,10,0,8">
                            <TextBlock Text="Circle template" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CircleTemplateList" SelectedIndex="0" AutomationProperties.Name="Circle template">
                              <ComboBoxItem Content="Browser" Tag="Browser" />
                              <ComboBoxItem Content="Media" Tag="Media" />
                              <ComboBoxItem Content="Window Management" Tag="WindowManagement" />
                            </ComboBox>
                            <WrapPanel Margin="0,8,0,0">
                              <Button Content="Apply template…" Click="ApplyCircleTemplate_Click" Margin="0,0,6,6" />
                              <Button Content="Export Circle…" Click="ExportCircleLayout_Click" Margin="0,0,6,6" />
                              <Button Content="Import Circle…" Click="ImportCircleLayout_Click" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock Text="Shareable files include built-in shortcuts and folders." Style="{StaticResource Caption}" FontSize="12" />
                          </StackPanel>
                        </Expander>
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </Border>
              </Grid>
            </local:FacetedBorder>
          </Grid>
          <ContentControl x:Name="CircleWorkspaceHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          <ScrollViewer x:Name="ProfilesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,32">
            <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">
              <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Profiles" FontSize="35" FontWeight="SemiBold" />
                  <TextBlock Text="Find default and app-specific settings by mouse." Style="{StaticResource Caption}" Margin="0,7,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Browse devices" Click="DevicesNav_Click" VerticalAlignment="Center" />
              </Grid>
              <local:FacetedBorder x:Name="EmptyProfiles" Style="{StaticResource Surface}" Visibility="Collapsed">
                <StackPanel><TextBlock Text="No saved mouse profiles" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Open a mouse from Devices to set up its first profile." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
              </local:FacetedBorder>
              <ItemsControl x:Name="ProfileManagerList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <local:FacetedBorder Style="{StaticResource Surface}" Margin="0,0,0,14">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Accent}" FontSize="18" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="{Binding DeviceName}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                          <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DashboardEdge}" Padding="0,9,0,6">
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Target}" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding AssignmentCount}" Foreground="{DynamicResource Muted}" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                  <Button Content="Rename" Tag="{Binding Id}" Click="RenameProfile_Click" Style="{StaticResource Quiet}" Margin="0,0,6,0" />
                                  <Button Content="Open" Tag="{Binding Id}" Click="OpenProfile_Click" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </local:FacetedBorder>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="SetupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,32"><StackPanel MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock x:Name="SetupStatusTitle" Text="Set up separate mouse controls" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="SetupStatusDescription" Style="{StaticResource Caption}" Margin="0,10,0,26" MaxWidth="690"/>
            <local:FacetedBorder Style="{StaticResource Surface}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,70,0"><TextBlock Text="Device input support" FontWeight="SemiBold"/><TextBlock Text="Driverless Circle · optional exclusive remapping" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="SetupBackendState" Grid.Column="1" Text="Checking input" Foreground="{DynamicResource Muted}"/></Grid></local:FacetedBorder>
            <ItemsControl x:Name="SetupConnectionRows" Margin="0,18,0,20"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="16,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Margin="0,0,30,0"/><TextBlock Text="{Binding Routing}" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="12"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <StackPanel Orientation="Horizontal"><Button Content="Setup details" Click="SetupGuide_Click"/><Button Content="Use existing installation…" Click="SelectInputLibrary_Click" Style="{StaticResource Quiet}" Margin="12,0,0,0"/></StackPanel>
            <Expander x:Name="SetupGuideExpander" Header="How device support works" Margin="0,20,0,0"><TextBlock Text="Assign Click Circle or Task View to a standard mouse button and select Enable Circle. Test the physical button outside Moushift. The middle button runs its assignment in place of a normal middle click. Other standard buttons also keep their normal behavior. Horizontal wheel directions can open Click Circle.&#10;&#10;Other shortcut assignments and vertical wheel triggers need exclusive input support. Custom HID assignments are saved as drafts." Style="{StaticResource Caption}" Margin="4,12,0,0" MaxWidth="680"/></Expander>
          </StackPanel></ScrollViewer>
          <ScrollViewer x:Name="AppearancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,32">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">
              <TextBlock Text="Settings" FontSize="35" FontWeight="SemiBold"/>
              <TextBlock Text="Appearance and preferences for your workspace." Style="{StaticResource Caption}" Margin="0,8,0,28"/>
              <local:FacetedBorder Style="{StaticResource Surface}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,40,0"><TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Applies immediately and stays saved on this computer." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
                <ComboBox x:Name="ThemeCombo" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Theme_Changed" VerticalAlignment="Center" AutomationProperties.Name="Interface theme"/>
              </Grid></local:FacetedBorder>
              <local:FacetedBorder Style="{StaticResource Surface}" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,28,0"><TextBlock Text="Input support" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="View the current assignment status for your devices." Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel><Button x:Name="SetupNav" Style="{StaticResource Quiet}" Grid.Column="1" VerticalAlignment="Center" Click="SetupNav_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Margin="0,0,12,0"/><TextBlock Text="Details"/></StackPanel></Button></Grid></local:FacetedBorder>
              <local:FacetedBorder Style="{StaticResource Surface}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Click Circle" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Translucent selection with a clear accent outline. Your circle actions belong to each profile." Style="{StaticResource Caption}" Margin="0,8,0,18"/><Button Content="Preview circle" Click="PreviewRing_Click" HorizontalAlignment="Left"/></StackPanel></local:FacetedBorder>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,32">
            <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">
              <TextBlock Text="Get started with Moushift" FontSize="27" FontWeight="SemiBold" />
              <TextBlock Text="Choose buttons, save actions, and enable your assignments." Style="{StaticResource Caption}" Margin="0,9,0,25" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <local:FacetedBorder Style="{StaticResource Surface}">
                  <StackPanel>
                    <TextBlock Text="Button mapping" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="1. Open a connection or shared assignments.&#10;2. Select a button on the drawing, or identify it by pressing it.&#10;3. Choose an action and Apply.&#10;4. Enable assignments from the toolbar." Style="{StaticResource Caption}" Margin="0,15,0,0" />
                    <Button Content="Edit buttons" Click="SharedMappings_Click" HorizontalAlignment="Left" Margin="0,20,0,0" />
                  </StackPanel>
                </local:FacetedBorder>
                <local:FacetedBorder Grid.Column="2" Style="{StaticResource Surface}">
                  <StackPanel>
                    <TextBlock Text="Shortcuts and Click Circle" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Click the shortcut field and press a key combination.&#10;&#10;Assign Click Circle to a standard mouse button to open its Circle, or choose Task View to open the Windows overview directly. Assigned middle clicks replace the original click. Click a Circle action to run it, click the center to leave a folder, or scroll over an adjustment. Hold-to-release selection is available with exclusive input support.&#10;&#10;Each profile has its own Circle. Preview shows its layout without running actions." Style="{StaticResource Caption}" Margin="0,15,0,0" />
                  </StackPanel>
                </local:FacetedBorder>
              </Grid>
              <local:FacetedBorder Style="{StaticResource Surface}" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="Pause and quit" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock x:Name="EmergencyHelp" Text="Pause stops assignments. The emergency shortcut appears in the status bar. Closing the window minimizes to the tray; choose Quit to exit." Style="{StaticResource Caption}" Margin="0,13,0,0" />
                </StackPanel>
              </local:FacetedBorder>
              <local:FacetedBorder Style="{StaticResource Surface}" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="Devices and profile scope" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="Each mouse uses its own profile. Driverless mode supports Click Circle and Task View on standard buttons, and Click Circle on horizontal wheel directions. Assigned middle clicks replace the native click. Other triggers retain their normal behavior. A receiver can remain listed while its mouse is off.&#10;&#10;Extra HID assignments are stored as drafts. DPI, lighting, and onboard memory are managed by the vendor app." Style="{StaticResource Caption}" Margin="0,13,0,0" />
                </StackPanel>
              </local:FacetedBorder>
              <local:FacetedBorder Style="{StaticResource Surface}" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="Local data" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="Profiles are saved locally for this Windows account. Elevated applications may require Moushift to run with matching permissions." Style="{StaticResource Caption}" Margin="0,13,0,18" />
                  <StackPanel Orientation="Horizontal"><Button Content="Open profile folder" Click="OpenSettingsFolder_Click"/><Button Content="Quit Moushift" Click="Quit_Click" Margin="12,0,0,0"/></StackPanel>
                  <Expander Header="Windows input details" Margin="0,22,0,0">
                    <ListBox x:Name="DevicesList" MaxHeight="240" Margin="0,12,0,0" AutomationProperties.Name="Windows mouse inputs">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="4">
                            <TextBlock Text="{Binding Name}" FontSize="12" />
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Expander>
                </StackPanel>
              </local:FacetedBorder>
              <TextBlock x:Name="AboutVersionText" Text="Moushift · Windows" Style="{StaticResource Caption}" Margin="0,24,0,8" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Grid Grid.Row="2" Margin="22,0" MaxWidth="1600">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" x:Name="InputStatusText" Text="Waiting for input" FontSize="11" Foreground="{DynamicResource Muted}" Margin="16,0" />
        <TextBlock Grid.Column="2" x:Name="EmergencyShortcutLabel" Text="Ctrl + Alt + F10" Foreground="{DynamicResource Muted}" FontSize="11" ToolTip="Pause assignments" />
      </Grid>
    </Grid>
  </Border>
</Window>

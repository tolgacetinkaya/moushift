<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Clickloom.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Clickloom.App.MainWindow" Title="Clickloom" Width="1400" Height="940" MinWidth="1100" MinHeight="760" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Loaded="Layout_Loaded" SizeChanged="Layout_SizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="ConnectionRow">
      <Button Click="DeviceCard_Click" IsEnabled="{Binding CanEdit}" Tag="{Binding}" HorizontalContentAlignment="Stretch" Padding="18,16" Margin="0,0,0,8" Background="{DynamicResource Panel}" AutomationProperties.Name="{Binding Name}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
          <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE962;" FontSize="23" Foreground="{DynamicResource Muted}"/>
          <StackPanel Grid.Column="1" Margin="8,0,20,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Routing}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding Activity}" Value="Separate input ready"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Activity}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
          <TextBlock Grid.Column="3" FontFamily="Segoe Fluent Icons" Text="&#xE76C;" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/>
        </Grid>
      </Button>
    </DataTemplate>

    <Style x:Key="DeviceTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="428"/><Setter Property="Margin" Value="7,0,7,14"/><Setter Property="Padding" Value="18"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border><ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource PanelLight}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Tile" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers>
    </Style>
    <DataTemplate x:Key="DeviceTileTemplate">
      <Button x:Name="DeviceTileButton" Click="DeviceCard_Click" Tag="{Binding}" IsEnabled="{Binding CanEdit}" Style="{StaticResource DeviceTile}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Detail}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel MinHeight="62" VerticalAlignment="Top">
            <TextBlock x:Name="DeviceTileName" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="20" MaxHeight="42" ToolTip="{Binding Name}"/>
            <TextBlock Text="{Binding Manufacturer}" Foreground="{DynamicResource Muted}" FontSize="10" TextAlignment="Center" Margin="0,8,0,0"/>
          </StackPanel>
          <local:MouseIllustration x:Name="DeviceTileArtwork" Grid.Row="1" Accent="{DynamicResource Accent}" Width="170" Height="216" Margin="0,6" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <StackPanel Grid.Row="2" Margin="0,8,0,0" MinHeight="54">
            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="16" TextWrapping="Wrap" TextAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Ellipse Width="5" Height="5" Margin="0,0,6,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding Activity}" Value="Input just now"><Setter Property="Fill" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
              <TextBlock Text="{Binding Activity}" FontSize="10" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
          </StackPanel>
          <Grid Grid.Row="3" Margin="0,16,0,0"><TextBlock Text="Customize" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76C;" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/></Grid>
        </Grid>
      </Button>
    </DataTemplate>
    <Style x:Key="ContextAction" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="32"/></Style>
    <Style x:Key="Marker" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="13">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource Quiet}">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
  </Window.Resources>
  <Border x:Name="ThemeFrame" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource MetalEdge}" BorderThickness="1" CornerRadius="10" TextElement.Foreground="{DynamicResource Ink}" TextElement.FontFamily="Segoe UI" TextElement.FontSize="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
        <RowDefinition Height="32" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="ThemeTitleBar" Grid.ColumnSpan="2" Background="{DynamicResource Metal}" BorderBrush="{DynamicResource MetalEdge}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock Text="clickloom" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="16,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="" FontFamily="Segoe Fluent Icons" Style="{StaticResource CaptionButton}" Click="Minimize_Click" AutomationProperties.Name="Minimize" />
            <Button Content="" FontFamily="Segoe Fluent Icons" Style="{StaticResource CaptionButton}" Click="Maximize_Click" AutomationProperties.Name="Maximize or restore" />
            <Button Content="" FontFamily="Segoe Fluent Icons" Style="{StaticResource CaptionButton}" Click="CloseWindow_Click" AutomationProperties.Name="Close window" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="10,16,10,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom">


            <Button x:Name="AppearanceNav" Style="{StaticResource Navigation}" Click="AppearanceNav_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Margin="0,0,12,0"/><TextBlock Text="Settings"/></StackPanel></Button>
            <Button x:Name="AboutNav" Style="{StaticResource Navigation}" Click="AboutNav_Click" Margin="0,3,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE897;" Margin="0,0,12,0" />
                <TextBlock Text="Help" FontSize="12" />
              </StackPanel>
            </Button>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <Button x:Name="DevicesNav" Style="{StaticResource Navigation}" Click="DevicesNav_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="" Margin="0,0,12,0" />
                <TextBlock Text="Devices" />
              </StackPanel>
            </Button>

            <Button x:Name="ProfilesNav" Style="{StaticResource Navigation}" Click="ProfilesNav_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="" Margin="0,0,12,0" />
                <TextBlock Text="Profiles" />
              </StackPanel>
            </Button>
            <TextBlock Text="Your devices" Foreground="{DynamicResource Muted}" FontSize="10" Margin="12,19,0,8" />
            <ItemsControl x:Name="SidebarDevicesList"><ItemsControl.ItemTemplate><DataTemplate>
              <Button Click="DeviceCard_Click" Tag="{Binding}" HorizontalContentAlignment="Stretch" FontSize="12" Padding="12,9" Margin="0,1">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource Selection}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="3,0,0,0"/></DataTrigger></Style.Triggers></Style></Button.Style>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE962;" FontSize="13" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></Grid>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>





          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="58" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PageTitle" Text="Buttons" FontSize="18" FontWeight="SemiBold" Margin="0,0,22,0" MinWidth="80" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2">
              <TextBlock x:Name="EngineBadge" Text="Paused" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,14,0" />
              <Button x:Name="EnableButton" Content="Enable" Click="Enable_Click" Style="{StaticResource Primary}" MinWidth="108" />
            </StackPanel>
            <Grid Margin="0,0,14,0" Grid.Column="1" x:Name="ProfileToolbar" Visibility="Collapsed" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="ProfilesList" Width="166" SelectionChanged="ProfilesList_SelectionChanged" DisplayMemberPath="Name" AutomationProperties.Name="Application profiles" />
              <Button Grid.Column="1" Content="Add app" Style="{StaticResource Quiet}" Click="AddProfile_Click" Margin="8,0,0,0" FontSize="12" />
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Border x:Name="MappingPage" Visibility="Collapsed" Background="{DynamicResource Bg}" Padding="24,18,24,10" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" MaxWidth="1600" MaxHeight="900" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
<Button x:Name="MappingsNav" Style="{StaticResource ContextAction}" Click="MappingsNav_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="" Margin="0,0,12,0" />
                <TextBlock Text="Buttons" />
              </StackPanel>
            </Button>
<Button x:Name="RingNav" Style="{StaticResource ContextAction}" Click="EditRing_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="" Margin="0,0,12,0" />
                <TextBlock Text="Edit Circle…" />
              </StackPanel>
            </Button>
              </StackPanel>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.9*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition x:Name="EditorColumn" Width="1.1*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="DiagramPane">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid x:Name="DiagramStage" MaxWidth="440" VerticalAlignment="Center" Height="480">
                    <local:MouseIllustration x:Name="HeroMouse" Accent="{DynamicResource Accent}" />
                    <local:MouseConnections x:Name="DiagramLinks" Visibility="Collapsed" IsHitTestVisible="False" />
                    <Canvas x:Name="MarkerCanvas">
                      <Button x:Name="LeftCallout" Style="{StaticResource Marker}" Content="1" Tag="LeftButton" Click="MouseCallout_Click" AutomationProperties.Name="Left button" />
                      <Button x:Name="RightCallout" Style="{StaticResource Marker}" Content="2" Tag="RightButton" Click="MouseCallout_Click" AutomationProperties.Name="Right button" />
                      <Button x:Name="MiddleCallout" Style="{StaticResource Marker}" Content="3" Tag="MiddleButton" Click="MouseCallout_Click" AutomationProperties.Name="Wheel button" />
                      <Button x:Name="ForwardCallout" Grid.Row="1" Style="{StaticResource Marker}" Content="4" Tag="XButton2" Click="MouseCallout_Click" AutomationProperties.Name="Forward button, front side button" />
                      <Button x:Name="BackCallout" Grid.Row="2" Style="{StaticResource Marker}" Content="5" Tag="XButton1" Click="MouseCallout_Click" AutomationProperties.Name="Back button, rear side button" />
                    </Canvas>
                    <StackPanel Visibility="Collapsed">
                      <TextBlock x:Name="LeftCalloutAction" />
                      <TextBlock x:Name="RightCalloutAction" />
                      <TextBlock x:Name="MiddleCalloutAction" />
                      <TextBlock x:Name="ForwardCalloutAction" />
                      <TextBlock x:Name="BackCalloutAction" />
                    </StackPanel>
                  </Grid>
                  <Button Grid.Row="1" x:Name="IdentifyButton" Content="Teach a button…" Click="IdentifyInput_Click" Style="{StaticResource Quiet}" HorizontalAlignment="Center" FontSize="12" />
                  <Expander Grid.Row="2" x:Name="ScopeExpander" Header="Input support" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock x:Name="ScopeLabel" Style="{StaticResource Caption}" />
                      <TextBlock x:Name="ScopeDescription" Style="{StaticResource Caption}" FontSize="12" />
                      <CheckBox x:Name="DeviceScopeCheck" Visibility="Collapsed" Content="Only this device" Checked="DeviceScope_Changed" Unchecked="DeviceScope_Changed" Margin="0,8,0,0" />
                      <TextBlock x:Name="DeviceScopeHint" Style="{StaticResource Caption}" FontSize="11" />
                      <CheckBox x:Name="ShowAuxiliaryCheck" Visibility="Collapsed" Content="Extra buttons (F13–F24)" Checked="ShowAuxiliary_Changed" Unchecked="ShowAuxiliary_Changed" Margin="0,10,0,0" />
                    </StackPanel>
                  </Expander>
                </Grid>
                <Grid Grid.Column="2">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Button" Foreground="{DynamicResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="Assigned action" Foreground="{DynamicResource Muted}" FontSize="12" />
                  </Grid>
                  <Expander x:Name="SourceExpander" Grid.Row="1" IsExpanded="True" Template="{StaticResource PlainExpander}">
                    <ListBox x:Name="BindingsList" Height="230" SelectionChanged="BindingsList_SelectionChanged" AutomationProperties.Name="Mouse buttons" ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                          <Setter Property="Padding" Value="10,7" />
                          <Setter Property="Margin" Value="0" />
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="34" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <Border Width="23" Height="23" Background="{DynamicResource Line}" CornerRadius="12" HorizontalAlignment="Left">
                              <TextBlock Text="{Binding Number}" FontSize="11" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />
                            <TextBlock Grid.Column="3" FontFamily="Segoe Fluent Icons" Text="" Foreground="{DynamicResource Muted}" FontSize="12" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Expander>
                  <Border Grid.Row="2" x:Name="EditorPane" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderThickness="0" CornerRadius="12" Padding="18">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock x:Name="SelectedInputTitle" Text="Back button" FontSize="16" FontWeight="SemiBold" Visibility="Collapsed" />
                          <TextBlock x:Name="SelectedInputHint" Text="Rear side button" Style="{StaticResource Caption}" Margin="0,7,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Close" Click="CloseEditor_Click" Style="{StaticResource Quiet}" FontSize="12" Padding="8,5" VerticalAlignment="Top" />
                      </Grid>
                      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                          <TextBlock Text="Action" Style="{StaticResource FieldLabel}" />
                          <ComboBox x:Name="ActionCombo" SelectionChanged="ActionCombo_SelectionChanged" DisplayMemberPath="Name" SelectedValuePath="Kind" AutomationProperties.Name="Atanacak eylem" />
                          <Border x:Name="ActionDescriptionBox" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ActionDescription" Style="{StaticResource Caption}" />
                          </Border>
                          <StackPanel x:Name="ShortcutPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="Shortcut" Style="{StaticResource FieldLabel}" FontSize="12" />
                            <local:ShortcutSelector x:Name="ShortcutChoice" Changed="ShortcutChoice_Changed" />
                            <Expander Header="Quick shortcuts" Margin="0,10,0,0">
                              <WrapPanel>
                                <Button Content="Alt + Tab" Tag="alt-tab" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Copy" Tag="copy" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Paste" Tag="paste" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Undo" Tag="undo" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Sekmeyi kapat" Tag="close" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Play / pause" Tag="media" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                                <Button Content="Mute" Tag="mute" Click="ShortcutPreset_Click" Padding="11,7" FontSize="12" Margin="0,0,6,7" />
                              </WrapPanel>
                            </Expander>
                          </StackPanel>
                          <StackPanel x:Name="MouseOutputPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="Output mouse button" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="MouseOutputCombo" DisplayMemberPath="Name" SelectedValuePath="Control" SelectionChanged="EditorField_Changed" AutomationProperties.Name="Output mouse button" />
                          </StackPanel>
                          <StackPanel x:Name="TextPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="Text to type" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TextActionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" MaxLength="10000" TextChanged="EditorField_Changed" AutomationProperties.Name="Text to type" />
                          </StackPanel>
                          <StackPanel x:Name="LaunchPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="Application to open" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseAction_Click" Margin="8,0,0,0" />
                              <TextBox x:Name="ApplicationPathBox" TextChanged="EditorField_Changed" AutomationProperties.Name="Application file" />
                            </DockPanel>
                            <TextBlock Text="Launch arguments (optional)" Style="{StaticResource Caption}" Margin="0,16,0,8" />
                            <TextBox x:Name="ArgumentsBox" TextChanged="EditorField_Changed" AutomationProperties.Name="Launch arguments" />
                          </StackPanel>
                          <StackPanel x:Name="RingPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <Border Background="{DynamicResource PanelLight}" CornerRadius="12" Padding="18">
                              <StackPanel>
                                <TextBlock Text="Eight actions. One button." FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Click and choose an action, or hold the button, move to a segment, and release. Open folders or scroll over adjustment segments." Style="{StaticResource Caption}" Margin="0,9,0,0" />
                              </StackPanel>
                            </Border>
                            <Button Content="Edit circle" Click="EditRing_Click" Margin="0,16,0,8" />
                            <Button Content="Open preview" Click="PreviewRing_Click" />
                          </StackPanel>
                          <TextBlock x:Name="AuxiliaryHint" Text="For an extra button configured as F13–F24 in your vendor app." Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,20,0,0" />
                          <Expander Header="Last input result" Margin="0,22,0,12">
                            <TextBlock x:Name="LastInputResultText" Text="No button detected yet." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                          </Expander>
                        </StackPanel>
                      </ScrollViewer>
                      <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                        <StackPanel>
                          <TextBlock x:Name="SavedActionText" Text="Saved: Default" Style="{StaticResource Caption}" Visibility="Collapsed" />
                          <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                              <Button Content="Restore default" Click="ResetBinding_Click" Style="{StaticResource Quiet}" Padding="0,2" FontSize="12" MinHeight="24" />
                              <TextBlock x:Name="DraftStatusText" Text="No changes" Foreground="{DynamicResource Muted}" FontSize="11" />
                            </StackPanel>
                            <Button x:Name="ApplyBindingButton" Grid.Column="1" Content="Apply" Click="SaveBinding_Click" Style="{StaticResource Primary}" MinWidth="92" VerticalAlignment="Center" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
              <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0">
                  <TextBlock x:Name="DeviceHeading" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="Mouse settings" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock x:Name="ProfileContext" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ImportPreviousButton" Content="Import previous…" Click="ImportPrevious_Click" Style="{StaticResource Quiet}" Padding="0,0,12,6" MinHeight="22" FontSize="12"/><Button Content="Reset buttons…" Click="ResetProfileButtons_Click" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Padding="0,0,0,6" MinHeight="22" FontSize="12"/></StackPanel><CheckBox x:Name="AutoSwitchCheck" Style="{StaticResource Switch}" Content="Automatic app switching" Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14,0,0,0" /></StackPanel>
              </Grid>
            </Grid>
          </Border>
          <ScrollViewer x:Name="DevicesPage" VerticalScrollBarVisibility="Auto" Padding="32,28">
            <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">
              <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Your devices" FontSize="27" FontWeight="SemiBold" />
                  <TextBlock x:Name="DevicesSubtitle" Text="Checking Windows mouse connections…" Style="{StaticResource Caption}" Margin="0,9,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="RefreshDevices_Click" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl x:Name="DeviceCardsList" ItemTemplate="{StaticResource DeviceTileTemplate}" Margin="-7,0,-7,0" KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="Choose a device to open its own buttons and Click Circle." Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,18"/>
              <Expander x:Name="AdditionalDevicesExpander" Header="Other pointing interfaces" Margin="0,14,0,18">
                <StackPanel><TextBlock Text="Virtual devices and pointing interfaces exposed by keyboards. These are not additional physical mice." Style="{StaticResource Caption}" Margin="0,10,0,14"/><ItemsControl x:Name="AdditionalDevicesList" ItemTemplate="{StaticResource ConnectionRow}"/></StackPanel>
              </Expander>
              <Border x:Name="EmptyDevicesBox" Background="{DynamicResource PanelLight}" CornerRadius="14" Padding="28" Margin="0,0,0,20">
                <StackPanel>
                  <TextBlock x:Name="EmptyDevicesText" Text="No mouse input connections found." FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="Connect a mouse or its receiver to create a separate profile. Receiver presence does not confirm mouse power." Style="{StaticResource Caption}" Margin="0,9,0,0" />
                </StackPanel>
              </Border>
              <Expander Header="Connection details" Margin="0,6,0,0">
                <StackPanel Margin="3,14,0,0">
                  <TextBlock Text="Move a mouse to identify its input connection. A receiver can remain visible while its wireless mouse is switched off." Style="{StaticResource Caption}" />
                  <TextBlock x:Name="PresenceDetails" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                </StackPanel>
              </Expander>
              <Expander Header="Device profile sources" Margin="0,16,0,0">
                <StackPanel Margin="3,14,0,0">
                  <TextBlock Text="Device-routing sources appear here when a supported backend is available. This list is not a connection indicator." Style="{StaticResource Caption}" />
                  <ItemsControl x:Name="DriverProfilesList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding Name}" Tag="{Binding}" Click="DeviceCard_Click" HorizontalAlignment="Left" Margin="0,4" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="ProfilesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,32">
            <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">
              <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Profiles" FontSize="27" FontWeight="SemiBold" />
                  <TextBlock Text="Separate defaults and application profiles for each mouse." Style="{StaticResource Caption}" Margin="0,9,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Add app for selected mouse" Click="AddProfile_Click" Style="{StaticResource Primary}" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl x:Name="ProfileManagerList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Surface}" Margin="0,0,0,14">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,22,0">
                          <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Target}" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                          <TextBlock Text="{Binding Scope}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="Rename" Tag="{Binding Id}" Click="RenameProfile_Click" Style="{StaticResource Quiet}" Margin="0,0,8,0" />
                          <Button Content="Edit" Tag="{Binding Id}" Click="OpenProfile_Click" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="{DynamicResource PanelLight}" CornerRadius="12" Padding="22" Margin="0,12,0,0">
                <TextBlock Text="Application switching stays within the same mouse. Without a matching application profile, that mouse uses its own default profile." Style="{StaticResource Caption}" />
              </Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="SetupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,32"><StackPanel MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock x:Name="SetupStatusTitle" Text="Set up separate mouse controls" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="SetupStatusDescription" Style="{StaticResource Caption}" Margin="0,10,0,26" MaxWidth="690"/>
            <Border Style="{StaticResource Surface}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,70,0"><TextBlock Text="Device input support" FontWeight="SemiBold"/><TextBlock Text="Required for independent mouse assignments" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="SetupBackendState" Grid.Column="1" Text="Not configured" Foreground="{DynamicResource Muted}"/></Grid></Border>
            <ItemsControl x:Name="SetupConnectionRows" Margin="0,18,0,20"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="16,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Margin="0,0,30,0"/><TextBlock Text="{Binding Routing}" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="12"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <StackPanel Orientation="Horizontal"><Button Content="Setup details" Click="SetupGuide_Click"/><Button Content="Use existing installation…" Click="SelectInputLibrary_Click" Style="{StaticResource Quiet}" Margin="12,0,0,0"/></StackPanel>
            <Expander x:Name="SetupGuideExpander" Header="How device support works" Margin="0,20,0,0"><TextBlock Text="Windows' standard mouse hook does not identify which mouse sent a button. Separate controls require a device input driver. Installation requires administrator approval and may require a restart.&#10;&#10;Clickloom does not install a driver automatically or apply old shared assignments to every mouse. Profiles can be prepared now and activated after input support is installed and verified." Style="{StaticResource Caption}" Margin="4,12,0,0" MaxWidth="680"/></Expander>
          </StackPanel></ScrollViewer>
          <ScrollViewer x:Name="AppearancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,32">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">
              <TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold"/>
              <TextBlock Text="Appearance and preferences for your workspace." Style="{StaticResource Caption}" Margin="0,8,0,28"/>
              <Border Style="{StaticResource Surface}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,40,0"><TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Applies immediately and stays saved on this computer." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
                <ComboBox x:Name="ThemeCombo" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Theme_Changed" VerticalAlignment="Center" AutomationProperties.Name="Interface theme"/>
              </Grid></Border>
              <Border Style="{StaticResource Surface}" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,28,0"><TextBlock Text="Input support" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="View the current assignment status for your devices." Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel><Button x:Name="SetupNav" Style="{StaticResource Quiet}" Grid.Column="1" VerticalAlignment="Center" Click="SetupNav_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Margin="0,0,12,0"/><TextBlock Text="Details"/></StackPanel></Button></Grid></Border>
              <Border Style="{StaticResource Surface}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Click Circle" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Translucent selection with a clear accent outline. Your circle actions belong to each profile." Style="{StaticResource Caption}" Margin="0,8,0,18"/><Button Content="Preview circle" Click="PreviewRing_Click" HorizontalAlignment="Left"/></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,32">
            <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">
              <TextBlock Text="Get started with Clickloom" FontSize="27" FontWeight="SemiBold" />
              <TextBlock Text="Choose buttons, save actions, and enable your assignments." Style="{StaticResource Caption}" Margin="0,9,0,25" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Surface}">
                  <StackPanel>
                    <TextBlock Text="Button mapping" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="1. Open a connection or shared assignments.&#10;2. Select a button on the drawing, or identify it by pressing it.&#10;3. Choose an action and Apply.&#10;4. Enable assignments from the toolbar." Style="{StaticResource Caption}" Margin="0,15,0,0" />
                    <Button Content="Edit buttons" Click="SharedMappings_Click" HorizontalAlignment="Left" Margin="0,20,0,0" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Surface}">
                  <StackPanel>
                    <TextBlock Text="Shortcuts and Click Circle" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Click the shortcut field and press a key combination.&#10;&#10;Assign Click Circle to a button. Click to select, or hold the button and release over a segment. Click the center to leave a folder. Scroll over an adjustment segment.&#10;&#10;Each profile has its own circle. Preview never executes actions." Style="{StaticResource Caption}" Margin="0,15,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Style="{StaticResource Surface}" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="Pause and quit" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock x:Name="EmergencyHelp" Text="Pause stops assignments. The emergency shortcut appears in the status bar. Closing the window minimizes to the tray; choose Quit to exit." Style="{StaticResource Caption}" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Surface}" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="Devices and profile scope" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="Each mouse uses its own profile. A mouse without a matching profile keeps its normal buttons. Device input support is required before assignments can be enabled. The device list shows Windows connections; receiver presence does not confirm mouse power.&#10;&#10;Extra buttons can be used when the vendor app can assign F13–F24 to them. DPI, lighting, and onboard memory are managed by the vendor app." Style="{StaticResource Caption}" Margin="0,13,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Surface}" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="Local data" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="Profiles are saved locally for this Windows account. Elevated applications may require Clickloom to run with matching permissions." Style="{StaticResource Caption}" Margin="0,13,0,18" />
                  <StackPanel Orientation="Horizontal"><Button Content="Open profile folder" Click="OpenSettingsFolder_Click"/><Button Content="Quit Clickloom" Click="Quit_Click" Margin="12,0,0,0"/></StackPanel>
                  <Expander Header="Windows input details" Margin="0,22,0,0">
                    <ListBox x:Name="DevicesList" MaxHeight="240" Margin="0,12,0,0" AutomationProperties.Name="Windows mouse inputs">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="4">
                            <TextBlock Text="{Binding Name}" FontSize="12" />
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Expander>
                </StackPanel>
              </Border>
              <TextBlock x:Name="AboutVersionText" Text="Clickloom · Windows" Style="{StaticResource Caption}" Margin="0,24,0,8" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Grid Grid.Row="2" Grid.Column="1" Margin="24,0" MaxWidth="1600">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" x:Name="InputStatusText" Text="Waiting for input" FontSize="11" Foreground="{DynamicResource Muted}" Margin="16,0" />
        <TextBlock Grid.Column="2" x:Name="EmergencyShortcutLabel" Text="Ctrl + Alt + F10" Foreground="{DynamicResource Muted}" FontSize="11" ToolTip="Pause assignments" />
      </Grid>
    </Grid>
  </Border>
</Window>
